{
  "manifest_version": 3,
  "name": "restoreyt",
  "author": "Jamie",
  "version": "2.0.0",
  "description": "See YouTube videos the way they were uploaded: original titles, descriptions, thumbnails and audio. No auto-translation, no AI dubbing.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.youtube-nocookie.com/*",
    "*://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "build/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "thumbnails",
        "enabled": true,
        "path": "rules/thumbnails.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube.com/live_chat*"
      ],
      "js": [
        "build/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "exclude_matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube.com/live_chat*"
      ],
      "js": [
        "build/content.js"
      ],
      "css": [
        "build/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "build/page.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/embed/*",
        "*://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "build/content.js"
      ],
      "css": [
        "build/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "restoreyt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
